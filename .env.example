# Copy to .env beside compose.local.yaml and set both private secrets.
WEB_CONFIG_SECRET=
EXTERNAL_SECRET=
# Example only: replace with this server's LAN address.
MYMIHOMO_LAN_IP=192.168.1.100
# Host proxy port; MIXED_PORT is the listener inside the container.
MYMIHOMO_PROXY_PORT=7891
# Host web port for compose.server.yaml; the gateway listens on 9097 inside.
MYMIHOMO_WEB_PORT=9097
MIXED_PORT=7897
WEB_CONFIG_PORT=9097
EXTERNAL_PORT=19097
EXTERNAL_BIND=127.0.0.1
TZ=Asia/Hong_Kong
TUN_ENABLE=false
CONF_FILE=/root/conf/config.yaml
WEB_ENV_FILE=/root/conf/web.env
# Optional first import; later edits belong in zashboard's subscription page.
CONF_URL=
CRON_EXPRESSION=30 12 * * *
CONF_TIMEOUT_SEC=45
CONF_RETRY=1
# Subscription downloads can use the running core inside this container.
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1
